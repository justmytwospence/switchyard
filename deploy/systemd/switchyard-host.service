# Switchyard host agent (systemd user unit). Written by `switchyard host install-service`.
[Unit]
Description=Switchyard host agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart="{{NODE}}" "{{CLI}}" host run --config "{{CONFIG}}" --state-dir "{{STATE_DIR}}"
Environment="PATH={{PATH}}"
WorkingDirectory={{HOME}}
Restart=on-failure
RestartSec=10
# process: terminal-session holders outlive agent restarts; the agent stops its own RPC Pi processes.
KillMode=process
TimeoutStopSec=30

[Install]
WantedBy=default.target
