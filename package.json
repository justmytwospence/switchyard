{
  "name": "switchyard",
  "version": "0.17.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @switchyard/web --if-present build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:fast": "vitest run --tags-filter=!slow",
    "test:tiers": "node scripts/check-test-tiers.mjs",
    "test:plugins": "node scripts/check-plugin-compat.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke --project=desktop-1440x900 --project=mobile-390x844",
    "adapter:preview": "node scripts/preview-adapter.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build:npm": "node scripts/build-npm.mjs",
    "build:client-npm": "node scripts/build-client-npm.mjs",
    "test:client-npm": "bash scripts/smoke-client-npm.sh",
    "icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
